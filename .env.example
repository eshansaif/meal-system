# PostgreSQL connection string.
# Local dev example (docker-compose service below): 
DATABASE_URL="postgresql://meal_user:meal_pass@localhost:5432/meal_system?schema=public"

# For Vercel + Neon/Supabase, use the pooled connection string they give you, e.g.:
# DATABASE_URL="postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/mealdb?sslmode=require"

# Secret used to sign JWT auth tokens. Generate with: openssl rand -base64 48
JWT_SECRET="replace-this-with-a-long-random-string"

# Timezone the organization operates in (used for cutoff enforcement)
ORG_TIMEZONE="Asia/Dhaka"

# Currency symbol shown across the UI
CURRENCY_SYMBOL="৳"
